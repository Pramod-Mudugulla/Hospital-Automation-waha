        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          160,
          300
        ]
      },
      {
        "parameters": {
          "jsCode": "\nconst raw = $input.first().json.body || $input.first().json;\nconst patient_id = raw.patient_id || 'DEMO-001';\nconst category = raw.category || 'Post-Discharge Medication & Care';\nconst approved_date = raw.approved_date || new Date().toISOString().slice(0, 10);\nconst approved_window = raw.approved_window || '48h';\nconst rating = parseInt(raw.rating || 5, 10);\nconst feedback = raw.feedback_comment || 'Satisfactory care';\n\n// Blueprint Prompt 4: Follow-up task creation\nreturn [{\n  json: {\n    patient_id,\n    category,\n    approved_date,\n    approved_window,\n    rating,\n    feedback,\n    owner: 'Care Coordinator'\n  }\n}];\n"
        },
        "id": "wf3-node-process-discharge",
        "name": "Process Discharge Data (Prompt 4)",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          380,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://localhost:3001/api/follow-ups",
