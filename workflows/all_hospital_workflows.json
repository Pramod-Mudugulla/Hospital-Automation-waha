          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"workflow_name\": \"HOSPITAL | 01 Lead Intake\",\n  \"record_id\": \"{{ $('AI Lead Qualification').item.json.correlation_id }}\",\n  \"error_type\": \"NO_SLOTS_AVAILABLE\",\n  \"severity\": \"high\",\n  \"owner\": \"Front Desk Coordinator\",\n  \"resolution_note\": \"No available slots for {{ $('AI Lead Qualification').item.json.department }} on {{ $('AI Lead Qualification').item.json.preferred_date }}. Contact patient to reschedule.\"\n}",
          "options": {}
        },
        "id": "wf1-node-log-exc",
        "name": "Log Exception Queue",
