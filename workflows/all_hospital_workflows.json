  {
    "name": "HOSPITAL | 03 Discharge Follow-Up",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "hospital-demo-discharge",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "hospital-demo-discharge",
