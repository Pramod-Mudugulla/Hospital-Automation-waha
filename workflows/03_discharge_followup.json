        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"HOSPITAL | 03 Discharge Follow-Up\",\n  \"action\": \"SATISFACTORY_DISCHARGE_FEEDBACK\",\n  \"record_id\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.patient_id }}\"\n}",
        "options": {}
      },
      "id": "wf3-node-log-satisfactory",
      "name": "Log Satisfactory Care",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1280,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"discharge_followup_complete\",\n  \"patient_id\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.patient_id }}\",\n  \"rating\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.rating }}\",\n  \"message\": \"Routine follow-up task and communication scheduled successfully\"\n}",
        "options": {}
      },
      "id": "wf3-node-respond-satisfactory",
      "name": "Respond Complete",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1500,
        420
      ]
    }
  ],
