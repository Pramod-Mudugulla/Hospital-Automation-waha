{
  "name": "HOSPITAL | 03 Discharge Follow-Up",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hospital-demo-discharge",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "hospital-demo-discharge",
      "id": "wf3-node-webhook",
      "name": "Webhook Discharge In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json.body || $input.first().json;\nconst patient_id = raw.patient_id || 'DEMO-001';\nconst category = raw.category || 'Post-Discharge Medication & Care';\nconst approved_date = raw.approved_date || new Date().toISOString().slice(0, 10);\nconst approved_window = raw.approved_window || '48h';\nconst rating = parseInt(raw.rating || 5, 10);\nconst feedback = raw.feedback_comment || 'Satisfactory care';\n\n// Blueprint Prompt 4: Follow-up task creation\nreturn [{\n  json: {\n    patient_id,\n    category,\n    approved_date,\n    approved_window,\n    rating,\n    feedback,\n    owner: 'Care Coordinator'\n  }\n}];\n"
      },
      "id": "wf3-node-process-discharge",
      "name": "Process Discharge Data (Prompt 4)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/follow-ups",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"patient_id\": \"{{ $json.patient_id }}\",\n  \"category\": \"{{ $json.category }}\",\n  \"approved_date\": \"{{ $json.approved_date }}\",\n  \"approved_window\": \"{{ $json.approved_window }}\",\n  \"owner\": \"{{ $json.owner }}\"\n}",
        "options": {}
      },
      "id": "wf3-node-create-task",
      "name": "Create Care Follow-Up Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/communication-logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"patient_id\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.patient_id }}\",\n  \"channel\": \"whatsapp\",\n  \"template_name\": \"DISCHARGE_CARE_01\",\n  \"workflow_name\": \"HOSPITAL | 03 Discharge Follow-Up\",\n  \"message_body\": \"Hi, we hope you are recovering well. A care coordinator will check in within {{ $('Process Discharge Data (Prompt 4)').item.json.approved_window }}. When you have a moment, please rate your stay from 1 to 5.\",\n  \"delivery_status\": \"delivered\"\n}",
        "options": {}
      },
      "id": "wf3-node-log-care-msg",
      "name": "Send Discharge Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "rating-check",
              "leftValue": "={{ $('Process Discharge Data (Prompt 4)').item.json.rating }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf3-node-if-rating",
      "name": "Rating < 3 (Negative)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/exceptions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"HOSPITAL | 03 Discharge Follow-Up\",\n  \"record_id\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.patient_id }}\",\n  \"error_type\": \"SERVICE_RECOVERY_ALERT\",\n  \"severity\": \"high\",\n  \"owner\": \"Patient Relations Officer\",\n  \"resolution_note\": \"Patient gave rating {{ $('Process Discharge Data (Prompt 4)').item.json.rating }}/5. Comment: '{{ $('Process Discharge Data (Prompt 4)').item.json.feedback }}'. Urgent service recovery needed.\"\n}",
        "options": {}
      },
      "id": "wf3-node-service-recovery",
      "name": "Create Service Recovery Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1280,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"service_recovery_escalated\",\n  \"patient_id\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.patient_id }}\",\n  \"rating\": \"{{ $('Process Discharge Data (Prompt 4)').item.json.rating }}\",\n  \"action\": \"High-severity service recovery ticket created for Patient Relations Officer\"\n}",
        "options": {}
      },
      "id": "wf3-node-respond-recov",
